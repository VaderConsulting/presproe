Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private CurScreen As Integer
Private Options As SEARCHOPTIONS
Private Titles() As String
Private SubTitles() As String
Private LastItem As ListItem
Private AniTmp As String
Private CancelPressed As Boolean
Private DirMax As Long
Private StartTime As Long
Private WithEvents SearchCore As cSearchCore
Attribute SearchCore.VB_VarHelpID = -1

Private Const SCRN_BEGIN = 0
Private Const SCRN_SEARCHMODE = 1
Private Const SCRN_RESTYPES = 2
Private Const SCRN_DESTFOLDER = 3
Private Const SCRN_FINISH = 4
Private Const SCRN_SEARCH = 5
Private Const SCRN_END = 6

Private Const Status = "Please wait while ResourcePro is looking for resources." & vbCrLf

Private Type FILEENTRY
    File As String
    Version As Long
End Type

Private Enum rpPriorityClasses
    HIGH_PRIORITY_CLASS = &H80
    ABOVE_NORMAL_PRIORITY_CLASS = &H8000
    NORMAL_PRIORITY_CLASS = &H20
    BELOW_NORMAL_PRIORITY_CLASS = &H4000
    IDLE_PRIORITY_CLASS = &H40
End Enum

Private Type SEARCHOPTIONS
    SearchSystem As Boolean
    Folder As String
    SubFolders As Boolean
    Mask As String
    ResTypes As RESTYPEOPTIONS
    DestPath As String
    Priority As Integer
End Type

Private Declare Function LockWindowUpdate Lib "user32" (ByVal hwndLock As Long) As Long
Private Declare Function GetSystemDirectory Lib "kernel32" Alias "GetSystemDirectoryA" (ByVal lpBuffer As String, ByVal nSize As Long) As Long
Private Declare Function SendMessageBynum Lib "user32" Alias "SendMessageA" (ByVal hwnd As Long, ByVal wMsg As Long, ByVal wParam As Long, ByVal lParam As Long) As Long
Private Const BM_SETSTYLE = &HF4
Private Const BS_BITMAP = &H80&
Private Declare Function GetWindowRect Lib "user32" (ByVal hwnd As Long, lpRect As RECT) As Long
Private Type RECT
    Left As Long
    Top As Long
    Right As Long
    Bottom As Long
End Type
Private Declare Function ClientToScreen Lib "user32" (ByVal hwnd As Long, lpPoint As POINTAPI) As Long
Private Type POINTAPI
    x As Long
    y As Long
End Type
Private Declare Function GetClientRect Lib "user32" (ByVal hwnd As Long, lpRect As RECT) As Long
Private Const CSIDL_PERSONAL = &H5
Private Const MAX_PATH = 260
Private Const S_OK = 0
Private Declare Function SHGetPathFromIDList Lib "shell32" Alias "SHGetPathFromIDListA" (ByVal PIDL As Long, ByVal pszPath As String) As Long
Private Declare Function SHGetSpecialFolderLocation Lib "shell32" (ByVal hwndOwner As Long, ByVal nFolder As Long, PIDL As Long) As Long
Private Declare Sub CoTaskMemFree Lib "ole32" (ByVal pv As Long)
Private Type BROWSEINFO
    hOwner           As Long
    pidlRoot         As Long
    pszDisplayName   As String
    lpszTitle        As String
    ulFlags          As Long
    lpfn             As Long
    lParam           As Long
    iImage           As Long
End Type
Private Const BIF_RETURNONLYFSDIRS = &H1
Private Declare Function SHBrowseForFolder Lib "shell32" Alias "SHBrowseForFolderA" (lpBrowseInfo As BROWSEINFO) As Long
Private Declare Function PathIsDirectory Lib "shlwapi" Alias "PathIsDirectoryA" (ByVal pszPath As String) As Long
Private Declare Function GetTempPath Lib "kernel32" Alias "GetTempPathA" (ByVal nBufferLength As Long, ByVal lpBuffer As String) As Long
Private Declare Function GetTempFileName Lib "kernel32" Alias "GetTempFileNameA" (ByVal lpszPath As String, ByVal lpPrefixString As String, ByVal wUnique As Long, ByVal lpTempFileName As String) As Long
Private Declare Function SendMessage Lib "user32" Alias "SendMessageA" (ByVal hwnd As Long, ByVal wMsg As Long, ByVal wParam As Long, lParam As Any) As Long
Private Const LVM_FIRST = &H1000
Private Const LVM_SETCOLUMNWIDTH = (LVM_FIRST + 30)
Private Const LVSCW_AUTOSIZE_USEHEADER = -2
Private Declare Sub Sleep Lib "kernel32" (ByVal dwMilliseconds As Long)
Private Const MF_BYPOSITION = &H400
Private Const MF_REMOVE = &H1000
Private Declare Function DrawMenuBar Lib "user32" (ByVal hwnd As Long) As Long
Private Declare Function GetMenuItemCount Lib "user32" (ByVal hMenu As Long) As Long
Private Declare Function GetSystemMenu Lib "user32" (ByVal hwnd As Long, ByVal bRevert As Long) As Long
Private Declare Function RemoveMenu Lib "user32" (ByVal hMenu As Long, ByVal nPosition As Long, ByVal wFlags As Long) As Long
Private Declare Sub PathQuoteSpaces Lib "shlwapi" Alias "PathQuoteSpacesA" (ByVal InPath As String)
Private Declare Function GetTickCount Lib "kernel32" () As Long
Private Declare Function StrFromTimeInterval Lib "shlwapi" Alias "StrFromTimeIntervalA" (ByVal pszOut As String, ByVal cchMax As Long, ByVal dwTimeMS As Long, ByVal dwDigits As Long) As Long
Private Declare Function GetVersionEx Lib "kernel32" Alias "GetVersionExA" (lpVersionInformation As OSVERSIONINFO) As Long
Private Type OSVERSIONINFO
    dwOSVersionInfoSize As Long
    dwMajorVersion As Long
    dwMinorVersion As Long
    dwBuildNumber As Long
    dwPlatformID As Long
    szCSDVersion As String * 128      '  Maintenance string for PSS usage
End Type
Private Declare Function SetPriorityClass Lib "kernel32" (ByVal hProcess As Long, ByVal dwPriorityClass As Long) As Long
Private Declare Function GetCurrentProcessId Lib "kernel32" () As Long
Private Const PROCESS_SET_INFORMATION = &H200
Private Const PROCESS_VM_READ = &H10
Private Const PROCESS_QUERY_INFORMATION = &H400
Private Declare Function OpenProcess Lib "kernel32" (ByVal dwDesiredAccess As Long, ByVal bInheritHandle As Long, ByVal dwProcessId As Long) As Long
Private Declare Function PathFindFileName Lib "shlwapi" Alias "PathFindFileNameA" (ByVal pPath As String) As Long
Private Declare Sub CopyMemoryToStr Lib "kernel32" Alias "RtlMoveMemory" (ByVal Destination As String, Source As Any, ByVal Length As Long)
Private Declare Function lstrlenPtr Lib "kernel32" Alias "lstrlenA" (ByVal lpLong As Long) As Long
Private Sub AutosizeListView(LVCtl As ListView)
    Dim Col As Long
    
    For Col = 0 To LVCtl.ColumnHeaders.Count - 1
        SendMessage LVCtl.hwnd, LVM_SETCOLUMNWIDTH, Col, _
            ByVal LVSCW_AUTOSIZE_USEHEADER
    Next Col
End Sub
Private Sub AddResStats()
    Dim LstImg As ListImage, AddImg As Boolean
    Dim NewItem As ListItem
        
    For Each LstImg In ilResTypes.ListImages
        AddImg = False
        Select Case LstImg.Key
            Case "BITMAP"
                If Options.ResTypes.Bitmap Then AddImg = True
            Case "ICON"
                If Options.ResTypes.Icon Then AddImg = True
            Case "CURSOR"
                If Options.ResTypes.Cursor Then AddImg = True
            Case "ANICURSOR"
                If Options.ResTypes.AniCursor Then AddImg = True
            Case "VIDEO"
                If Options.ResTypes.Video Then AddImg = True
            Case "HTML"
                If Options.ResTypes.HTML Then AddImg = True
        End Select
        If AddImg Then
            Set NewItem = lvResStats.ListItems.Add
            With NewItem
                .Key = LstImg.Key
                .Text = LstImg.Tag
                .SmallIcon = LstImg.Index
                .SubItems(1) = 0
            End With
        End If
    Next LstImg
    
    AutosizeListView lvResStats
End Sub
Private Function AdjustPath(MyPath As String) As String
    If Right(MyPath, 1) <> "\" Then
        AdjustPath = MyPath & "\"
    Else
        AdjustPath = MyPath
    End If
End Function

Private Function BrowseForFolder(Title As String) As String
    Dim Info As BROWSEINFO, PIDL As Long
    Dim MyPath As String
    
    With Info
        .hOwner = Me.hwnd
        .pidlRoot = 0&
        .lpszTitle = Title
        .ulFlags = BIF_RETURNONLYFSDIRS
    End With
    PIDL = SHBrowseForFolder(Info)
    
    MyPath = Space(MAX_PATH)
    If SHGetPathFromIDList(ByVal PIDL, ByVal MyPath) Then
        BrowseForFolder = Left(MyPath, InStr(MyPath, Chr(0)) - 1)
    End If
    
    CoTaskMemFree PIDL
End Function

Private Sub ChangePriorityClass()
    Dim MyPriority As Long, ProcessID As Long, hProcess As Long
    
    MyPriority = GetPriorityVal
    
    ProcessID = GetCurrentProcessId
    hProcess = OpenProcess(PROCESS_QUERY_INFORMATION Or _
        PROCESS_SET_INFORMATION Or PROCESS_VM_READ, 0, ProcessID)
    If hProcess <> 0 Then
        SetPriorityClass hProcess, MyPriority
    End If
End Sub
Private Function CheckPath(MyPath As String) As Boolean
    If PathIsDirectory(MyPath) = 0 Then
        MsgBox "The folder could not be found." & vbCrLf & _
            "Please specify a valid folder.", vbCritical
        txtFolder.SetFocus
        CheckPath = True
    End If
End Function
Private Function CheckTypes() As Boolean
    With Options.ResTypes
        If (Not .Bitmap) And (Not .Icon) And (Not .Cursor) And _
            (Not .AniCursor) And (Not .Video) And (Not .HTML) Then
            CheckTypes = True
            MsgBox "Please choose at least one resource type.", _
                vbCritical
            lvResTypes.SetFocus
        End If
    End With
End Function

Private Function GetMyDocuments() As String
    Dim MyPath As String
    Dim PIDL As Long
   
    If SHGetSpecialFolderLocation(Me.hwnd, CSIDL_PERSONAL, PIDL) _
        = S_OK Then
        MyPath = Space(MAX_PATH)
        
        If SHGetPathFromIDList(ByVal PIDL, ByVal MyPath) Then
            CoTaskMemFree PIDL
            GetMyDocuments = Left(MyPath, InStr(MyPath, Chr(0)) - 1)
        End If
    End If
End Function
Private Function GetPriorityVal() As rpPriorityClasses
    Dim MyPriority As rpPriorityClasses
    
    MyPriority = Choose(Options.Priority, IDLE_PRIORITY_CLASS, _
        BELOW_NORMAL_PRIORITY_CLASS, NORMAL_PRIORITY_CLASS, _
        NORMAL_PRIORITY_CLASS, ABOVE_NORMAL_PRIORITY_CLASS, _
        HIGH_PRIORITY_CLASS)
        
    If ((MyPriority = BELOW_NORMAL_PRIORITY_CLASS) Or _
        (MyPriority = ABOVE_NORMAL_PRIORITY_CLASS)) And _
        (Not IsWin2000) Then
        MyPriority = MyPriority / &H100
    End If
    
    GetPriorityVal = MyPriority
End Function
Private Function IsWin2000() As Boolean
    Dim OSInfo As OSVERSIONINFO
    
    OSInfo.dwOSVersionInfoSize = Len(OSInfo)
    
    GetVersionEx OSInfo
    
    With OSInfo
        Select Case .dwMajorVersion
            Case 5
                Select Case .dwMinorVersion
                    Case 0
                        If .dwBuildNumber >= 2195 Then
                            IsWin2000 = True
                        End If
                    Case Is > 0
                        IsWin2000 = True
                End Select
            Case Is > 5
                IsWin2000 = True
        End Select
    End With
End Function
Private Function GetTimeString(ms As Long) As String
    Dim TimeStr As String
    
    TimeStr = Space(64)
    
    StrFromTimeInterval TimeStr, Len(TimeStr) - 1, ms, 3
    GetTimeString = NullTrim(TimeStr)
End Function
Private Sub InitListView()
    Dim LstImg As ListImage
    
    For Each LstImg In ilResTypes.ListImages
        With LstImg
            lvResTypes.ListItems.Add , .Key, .Tag, , .Index
        End With
    Next LstImg
End Sub


Private Sub InitOptions()
    With Options
        If Not GetOptVal("SearchSystem", .SearchSystem) Then
            .SearchSystem = True
        End If
        If Not GetOptVal("Folder", .Folder) Then
            .Folder = GetSysDir
        End If
        If Not GetOptVal("SubFolders", .SubFolders) Then
            .SubFolders = True
        End If
        If Not GetOptVal("Mask", .Mask) Then
            .Mask = "*.exe;*.dll;*.ocx;*.cpl;*.scr;*.vbx"
        End If
        If Not GetOptVal("ResTypesBitmap", .ResTypes.Bitmap) Then
            .ResTypes.Bitmap = True
        End If
        If Not GetOptVal("ResTypesIcon", .ResTypes.Icon) Then
            .ResTypes.Icon = True
        End If
        If Not GetOptVal("ResTypesCursor", .ResTypes.Cursor) Then
            .ResTypes.Cursor = True
        End If
        If Not GetOptVal("ResTypesAniCursor", .ResTypes.AniCursor) Then
            .ResTypes.AniCursor = True
        End If
        If Not GetOptVal("ResTypesVideo", .ResTypes.Video) Then
            .ResTypes.Video = True
        End If
        If Not GetOptVal("ResTypesHTML", .ResTypes.HTML) Then
            .ResTypes.HTML = True
        End If
        If Not GetOptVal("DestPath", .DestPath) Then
            .DestPath = AdjustPath(GetMyDocuments) & "Resources"
        End If
        If Not GetOptVal("Priority", .Priority) Then
            .Priority = 3
        End If
    End With
End Sub
Private Sub MakeIndexFile(FileName As String)
    Dim FileNum As Integer
    
    FileNum = FreeFile
    
    Open FileName For Append Access Write As #FileNum
    
    Print #FileNum, vbCrLf & "ResourcePro index file of " & Now
    Print #FileNum, "Search in " & Options.Folder & IIf(Options _
        .SubFolders, " and subfolders", Empty)
    Print #FileNum, "File mask: " & Options.Mask & vbCrLf
        
    Close #FileNum
End Sub
Private Sub SaveOptions()
    With Options
        SetOptVal "SearchSystem", .SearchSystem
        SetOptVal "Folder", .Folder
        SetOptVal "SubFolders", .SubFolders
        SetOptVal "Mask", .Mask
        SetOptVal "ResTypesBitmap", .ResTypes.Bitmap
        SetOptVal "ResTypesIcon", .ResTypes.Icon
        SetOptVal "ResTypesCursor", .ResTypes.Cursor
        SetOptVal "ResTypesAniCursor", .ResTypes.AniCursor
        SetOptVal "ResTypesVideo", .ResTypes.Video
        SetOptVal "ResTypesHTML", .ResTypes.HTML
        SetOptVal "DestPath", .DestPath
        SetOptVal "Priority", .Priority
    End With
End Sub
Private Sub SetOptVal(OptName As String, NewVal As Variant)
    Dim Reg As New cRegistry
    
    Reg.ClassKey = HKEY_LOCAL_MACHINE
    Reg.SectionKey = "Software\ResourcePro"
    
    Reg.ValueKey = OptName
    
    If Not Reg.KeyExists Then
        Reg.CreateKey
    End If
    
    Select Case VarType(NewVal)
        Case vbLong
            Reg.ValueType = REG_DWORD
            Reg.Value = CLng(NewVal)
        Case vbInteger
            Reg.ValueType = REG_DWORD
            Reg.Value = CLng(NewVal)
        Case vbBoolean
            Reg.ValueType = REG_DWORD
            Reg.Value = IIf(NewVal, 1, 0)
        Case vbString
            Reg.ValueType = REG_SZ
            Reg.Value = CStr(NewVal)
    End Select
    
    Set Reg = Nothing
End Sub
Private Function GetOptVal(OptName As String, Value As Variant) As Boolean
    Dim Reg As New cRegistry
    
    Reg.ClassKey = HKEY_LOCAL_MACHINE
    Reg.SectionKey = "Software\ResourcePro"
    
    Reg.ValueKey = OptName
    
    If Reg.KeyExists Then
        Value = Reg.Value
        GetOptVal = True
    End If
    
    Set Reg = Nothing
End Function
Private Sub InitTitles()
    ReDim Titles(0 To fraScreen.UBound)
    ReDim SubTitles(0 To fraScreen.UBound)
    
    Titles(1) = "Search mode"
    SubTitles(1) = "Specify here where the search should take place."
    
    Titles(2) = "Resource types"
    SubTitles(2) = "Check the resource types you are looking for."

    Titles(3) = "Destination"
    SubTitles(3) = "Please choose a destination folder for the resources."

    Titles(4) = "Ready"
    SubTitles(4) = "ResourcePro is ready for the search."

    Titles(5) = "Search in progress..."
    SubTitles(5) = "The operation may take several minutes."
End Sub


Private Sub KillCloseButton()
    Dim hMenu As Long, ItemCount As Long
    
    hMenu = GetSystemMenu(Me.hwnd, 0)
    If hMenu Then
        ItemCount = GetMenuItemCount(hMenu)
        RemoveMenu hMenu, ItemCount - 1, MF_REMOVE Or _
            MF_BYPOSITION
        RemoveMenu hMenu, ItemCount - 2, MF_REMOVE Or _
            MF_BYPOSITION
        DrawMenuBar Me.hwnd
    End If
End Sub
Public Function LoadAnim(AniCtl As Animation, ResID As Variant) As String
    Dim Data() As Byte, TmpPath As String, Prefix As String
    Dim FileNum As Integer
    
    TmpPath = Space(260)
    Prefix = "ifr"
    
    If GetTempPath(Len(TmpPath) - 1, TmpPath) <> 0 Then
        If GetTempFileName(TmpPath, Prefix, 0, TmpPath) <> 0 Then
            TmpPath = NullTrim(TmpPath)
            FileNum = FreeFile
            Data = LoadResData(ResID, "AVI")
            On Error GoTo Cancel
            Open TmpPath For Binary Access Write As #FileNum
                On Error GoTo 0
                Put #FileNum, , Data
            Close #FileNum
            AniCtl.Open TmpPath
        End If
    End If
Cancel:
End Function
Private Function NullTrim(MyString As String) As String
    Dim Pos As Integer
    
    Pos = InStr(MyString, Chr(0))
    
    If Pos Then
        NullTrim = Left(MyString, Pos - 1)
    Else
        NullTrim = MyString
    End If
End Function
Private Sub MakeBMStyleButton(Button As CommandButton)
    SendMessageBynum Button.hwnd, BM_SETSTYLE, BS_BITMAP, True
End Sub
Private Function GetSysDir() As String
    Dim Buffer As String, RetVal As Long
    
    Buffer = Space(256)
    
    RetVal = GetSystemDirectory(Buffer, Len(Buffer) - 1)
    
    If RetVal <> 0 Then
        GetSysDir = Left(Buffer, RetVal)
    End If
End Function


Private Function MakeResDir(ByVal BasePath As String)
    Dim IsRoot As Boolean
    
    BasePath = AdjustPath(BasePath)
    IsRoot = True
    On Error GoTo MkDirErr
    MkDir BasePath
    IsRoot = False
    With Options.ResTypes
        MakeIndexFile BasePath & IdxFile
        If .Bitmap Then
            MkDir BasePath & "Bitmaps"
            MakeIndexFile BasePath & "Bitmaps\" & IdxFile
        End If
        If .Icon Then
            MkDir BasePath & "Icons"
            MakeIndexFile BasePath & "Icons\" & IdxFile
        End If
        If .Cursor Then
            MkDir BasePath & "Cursors"
            MakeIndexFile BasePath & "Cursors\" & IdxFile
        End If
        If .AniCursor Then
            MkDir BasePath & "Animated Cursors"
            MakeIndexFile BasePath & "Animated Cursors\" & IdxFile
        End If
        If .Video Then
            MkDir BasePath & "Videos"
            MakeIndexFile BasePath & "Videos\" & IdxFile
        End If
        If .HTML Then
            MkDir BasePath & "Web pages"
            MakeIndexFile BasePath & "Web pages\" & IdxFile
        End If
    End With
    On Error GoTo 0
    Exit Function
MkDirErr:
    Select Case Err.Number
        Case 76
            MsgBox "The specified folder is invalid." & vbCrLf & _
                "Please type another name.", vbCritical
            txtDestPath.SetFocus
            MakeResDir = True
        Case 75
            If IsRoot Then
                If MsgBox("The specified folder already exists." & vbCrLf & _
                    "Do you want to continue?", vbExclamation Or _
                    vbYesNo) = vbYes Then
                    Resume Next
                Else
                    txtDestPath.SetFocus
                    MakeResDir = True
                End If
            End If
        Case Else
            Resume Next
    End Select
End Function
Private Sub ProcessScreen(ScreenNum As Integer)
    With Options
        Select Case ScreenNum
            Case SCRN_SEARCHMODE
                If .SearchSystem Then
                    optSearchSystem = True
                Else
                    optSearchFolder = True
                End If
                txtFolder = .Folder
                chkSubFolders = Abs(.SubFolders)
                txtMask = .Mask
                sldAccel = .Priority
                sldAccel_Scroll
            Case SCRN_RESTYPES
                With lvResTypes.ListItems
                    .Item("BITMAP").Checked = Options.ResTypes.Bitmap
                    .Item("ICON").Checked = Options.ResTypes.Icon
                    .Item("CURSOR").Checked = Options.ResTypes.Cursor
                    .Item("ANICURSOR").Checked = Options.ResTypes.AniCursor
                    .Item("VIDEO").Checked = Options.ResTypes.Video
                    .Item("HTML").Checked = Options.ResTypes.HTML
                End With
            Case SCRN_DESTFOLDER
                txtDestPath = .DestPath
            Case SCRN_SEARCH
                AddResStats
                AniTmp = LoadAnim(aniAnim, "FINDFILES")
                aniAnim.Play
                KillCloseButton
            Case SCRN_END
                Me.Caption = App.Title
                cmdCancel.Caption = "Close"
        End Select
    End With
End Sub
Private Function ProcessScreenEnd(ScreenNum As Integer) As Boolean
    With Options
        Select Case ScreenNum
            Case SCRN_SEARCHMODE
                .SearchSystem = optSearchSystem
                .Folder = txtFolder
                .SubFolders = -chkSubFolders
                .Mask = txtMask
                If optSearchFolder Then
                    ProcessScreenEnd = CheckPath(txtFolder)
                End If
            Case SCRN_RESTYPES
                With lvResTypes.ListItems
                    Options.ResTypes.Bitmap = .Item("BITMAP").Checked
                    Options.ResTypes.Icon = .Item("ICON").Checked
                    Options.ResTypes.Cursor = .Item("CURSOR").Checked
                    Options.ResTypes.AniCursor = .Item("ANICURSOR").Checked
                    Options.ResTypes.Video = .Item("VIDEO").Checked
                    Options.ResTypes.HTML = .Item("HTML").Checked
                End With
                ProcessScreenEnd = CheckTypes
            Case SCRN_DESTFOLDER
                .DestPath = txtDestPath
                ProcessScreenEnd = MakeResDir(txtDestPath)
            Case SCRN_SEARCH
                On Error Resume Next
                Kill AniTmp
                On Error GoTo 0
        End Select
    End With
End Function
Public Sub ResFound(ResType As RESOURCETYPES, ResName As Variant)
    Dim ItemKey As String

    Select Case ResType
        Case rcrtBitmap: ItemKey = "BITMAP"
        Case rcrtIcon: ItemKey = "ICON"
        Case rcrtCursor: ItemKey = "CURSOR"
        Case rcrtAniCursor: ItemKey = "ANICURSOR"
        Case rcrtVideo: ItemKey = "VIDEO"
        Case rcrtHTML: ItemKey = "HTML"
    End Select
    
    lvResStats.ListItems(ItemKey).SubItems(1) = _
        Val(lvResStats.ListItems(ItemKey).SubItems(1)) + 1
End Sub
Private Sub ShowScreen(ScreenNum As Integer)
    Dim n As Integer
    
    If ProcessScreenEnd(CurScreen) Then Exit Sub
    
    CurScreen = ScreenNum
    
    Select Case CurScreen
        Case Is < 0
            Exit Sub
        Case Is > fraScreen.UBound
            cmdCancel_Click
            Exit Sub
    End Select
    
    LockWindowUpdate Me.hwnd
    
    lblScrnTitle = Titles(CurScreen)
    lblScrnSubTitle = SubTitles(CurScreen)
    ProcessScreen (CurScreen)
    
    For n = 0 To fraScreen.UBound
        If n <> CurScreen Then
            fraScreen(n).Visible = False
        Else
            fraScreen(n).Visible = True
        End If
    Next n

    fraScreen(CurScreen).ZOrder
    
    If CurScreen >= 1 Then
        fraWatermark.Visible = False
        fraScreenHdr.Visible = True
        fraScreenHdr.ZOrder
        cmdBack.Enabled = True
    Else
        fraScreenHdr.Visible = False
        cmdBack.Enabled = False
    End If
    Select Case CurScreen
        Case SCRN_BEGIN
            cmdBack.Enabled = False
            cmdNext.Caption = "&Next >"
        Case SCRN_SEARCHMODE, SCRN_RESTYPES, SCRN_DESTFOLDER
            cmdBack.Enabled = True
            cmdNext.Caption = "&Next >"
        Case SCRN_FINISH
            cmdBack.Enabled = True
            cmdNext.Caption = "Finish"
        Case SCRN_SEARCH
            cmdBack.Enabled = False
            cmdNext.Enabled = False
        Case SCRN_END
            cmdBack.Enabled = False
            cmdNext.Enabled = False
            fraScreenHdr.Visible = False
            fraWatermark.Visible = True
            fraWatermark.ZOrder
    End Select
    
    LockWindowUpdate False
    
    If CurScreen = SCRN_SEARCH Then
        Me.Refresh
        StartSearch
    End If
End Sub

Private Sub StartSearch()
    ChangePriorityClass
    
    If Options.SearchSystem Then
        cmdCancel.Enabled = False
        lblStatus = Status & "Initializing..."
        lblStatus.Refresh
        DirMax = SearchCore.GetDirCount(True)
        l3dProgressBack.Visible = True
        lblStatus = Status
        lblStatus.Refresh
        cmdCancel.Enabled = True
        StartTime = GetTickCount
        SearchCore.SearchSystemForFiles Options.Mask
    Else
        If Options.SubFolders Then
            cmdCancel.Enabled = False
            lblStatus = Status & "Initializing..."
            lblStatus.Refresh
            DirMax = SearchCore.GetDirCount(False, Options.Folder)
            l3dProgressBack.Visible = True
            cmdCancel.Enabled = True
        End If
        lblStatus = Status
        lblStatus.Refresh
        StartTime = GetTickCount
        SearchCore.SearchForFiles Options.Folder, _
            Options.SubFolders, Options.Mask
    End If
End Sub

Private Sub cmdAdvanced_Click()
    cmdAdvanced.Visible = False
    fraMask.Visible = True
    fraPerformance.Visible = True
End Sub

Private Sub cmdBack_Click()
    ShowScreen CurScreen - 1
End Sub

Private Sub cmdBrowse_Click()
    txtFolder = BrowseForFolder("Bitte wählen Sie den Ordner, in dem nach Ressourcen gesucht werden soll.")
End Sub

Private Sub cmdBrowse_GotFocus()
    MakeBMStyleButton cmdBrowse
End Sub


Private Sub cmdBrowseDest_Click()
    txtDestPath = BrowseForFolder("Bitte wählen Sie den Ordner, in dem die Ressourcen abgelegt werden sollen.")
End Sub

Private Sub cmdBrowseDest_GotFocus()
    MakeBMStyleButton cmdBrowseDest
End Sub


Private Sub cmdCancel_Click()
    If CurScreen = SCRN_SEARCH Then
        If MsgBox("Are you sure you want to cancel the search?", _
            vbExclamation Or vbYesNo) = vbYes Then
            cmdCancel.Enabled = False
            CancelPressed = True
            Unload Me
        End If
    Else
        Unload Me
    End If
End Sub
Private Sub cmdNext_Click()
    ShowScreen CurScreen + 1
End Sub


Private Sub cmdShowFolder_Click()
    Dim DestPath As String
    
    DestPath = Options.DestPath
    PathQuoteSpaces (DestPath)
    
    Shell "explorer /root ," & DestPath, vbNormalFocus
End Sub

Private Sub cmdShowFolder_GotFocus()
    MakeBMStyleButton cmdShowFolder
End Sub


Private Sub Form_Initialize()
    Set SearchCore = New cSearchCore
End Sub

Private Sub Form_Load()
    InitTitles
    InitOptions
    InitListView
End Sub

Private Sub Form_Unload(Cancel As Integer)
    SaveOptions
    End
End Sub

Private Sub lvResTypes_MouseMove(Button As Integer, Shift As Integer, x As Single, y As Single)
    Dim WinRect As RECT, ClientRect As RECT, TmpPos As POINTAPI
    Dim XPos As Integer, YPos As Integer, Item As ListItem
        
    Set Item = lvResTypes.HitTest(0, y)
    If Item Is Nothing Then Exit Sub
    If Item Is LastItem Then Exit Sub
    
    GetWindowRect lvResTypes.hwnd, WinRect
    GetClientRect lvResTypes.hwnd, ClientRect
    ClientToScreen lvResTypes.hwnd, TmpPos
    
    XPos = WinRect.Right + 16
    YPos = TmpPos.y + Item.Top \ Screen.TwipsPerPixelY
    
    Set LastItem = Item
End Sub
Private Sub optSearchFolder_Click()
    txtFolder.Enabled = True
    cmdBrowse.Enabled = True
    chkSubFolders.Enabled = True
End Sub

Private Sub optSearchSystem_Click()
    txtFolder.Enabled = False
    cmdBrowse.Enabled = False
    chkSubFolders.Enabled = False
End Sub


Private Sub SearchCore_FileFound(FileName As String, FileCount As Long, DirCount As Long, Cancel As Boolean)
    Dim ProgVal As Long, TimeDiff As Long, TimeRemain As Long
    
    If CancelPressed Then
        Cancel = True
    End If
    If Options.SubFolders Then
        ProgVal = (DirCount / DirMax) * 50
        If prbProgress <> ProgVal Then
            If ProgVal <= DirMax Then
                prbProgress = ProgVal
                Me.Caption = App.Title & " - " & ProgVal * 2 & "% completed"
                TimeDiff = GetTickCount - StartTime
                If TimeDiff > 10000 Then
                    TimeRemain = ((DirMax - DirCount) / DirCount) * TimeDiff
                    If TimeRemain > 10000 Then
                        lblStatus = Status & "Remaining time: " & _
                            GetTimeString(TimeRemain)
                    End If
                End If
            End If
        End If
    End If
    If mResCore.SearchForResources(FileName, Options.ResTypes, Me, _
        Options.DestPath) Then
        Cancel = True
        MsgBox "An error has occured during the search." & vbCrLf & _
            "ResourcePro will now close.", vbCritical
        cmdCancel.Enabled = False
        aniAnim.Stop
        Sleep 1500
        Unload Me
    End If
    If (FileCount Mod 10) = 0 Then
        DoEvents
    End If
End Sub
Private Function PtrToStr(StrPtr As Long) As String
    Dim StrPtrLen As Long

    StrPtrLen = lstrlenPtr(StrPtr)
    PtrToStr = Space(StrPtrLen)

    CopyMemoryToStr PtrToStr, ByVal StrPtr, StrPtrLen
End Function

Private Sub SearchCore_SearchFinished()
    cmdNext_Click
End Sub


Private Sub sldAccel_Scroll()
    lblPriority = Choose(sldAccel, "Lowest priority", _
        "Low priority", "Default priority", _
        "High priority", "Highest priority")
    Options.Priority = sldAccel
End Sub
